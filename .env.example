# ---------------------------------------------------------------------------
# Bible Secrets — environment
# Copy to `.env.local` and fill in. Everything works without these (local/demo
# mode); adding them switches the platform onto live services.
# ---------------------------------------------------------------------------

# --- Supabase (database, auth, storage) ------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for admin uploads and signed reader URLs. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_BUCKET_COVERS=covers
SUPABASE_BUCKET_BOOKS=books
SUPABASE_BUCKET_MEDIA=media

# --- Paystack (full access after the 90-day trial, donations) --------------
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=KES
# Amount in the major unit (KSh). 500 = KSh 500.
BIBLE_SECRETS_PRICE=500

# --- Membership ------------------------------------------------------------
# Free full access window in days (the plan: 3 months).
BIBLE_SECRETS_TRIAL_DAYS=90
# Comma-separated emails allowed into /admin. Empty = any signed-in account
# (swap this on before you go public).
BIBLE_SECRETS_ADMINS=

# --- Bible Technology (Bereshit Lab workbench) ----------------------------
# Server-side address of the Python engine (bible-tech/server.py). The site
# proxies it at /engine, so the browser never talks to this port directly —
# no CORS, no localhost leaking into the preview or production.
BERESHIT_URL=http://127.0.0.1:8080
# Legacy alias, still honoured: NEXT_PUBLIC_BERESHIT_URL=http://localhost:8080

# --- Demo helpers ----------------------------------------------------------
# 1 = serve the generated sample editions when a volume has no live source yet.
# Set to 0 once the real PDFs stream from storage.
BIBLE_SECRETS_SAMPLES=1
# WhatsApp group link shown on the Tuesday live page.
NEXT_PUBLIC_WHATSAPP_URL=
